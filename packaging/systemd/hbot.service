# 部署物（M9 本地可写那一半）。真机从未运行过，见 packaging/README.md 的状态声明。
#
# systemd-analyze verify packaging/systemd/hbot.service 在 Windows 上没法跑，
# 第一次上真机请先 systemctl daemon-reload 再看 systemctl status 的报错。
[Unit]
Description=HBot QQ 机器人运行时（headless serve）
Documentation=file:///usr/share/doc/hbot/README.md
# hbot serve 自己就要连 adapter/LLM/WebSocket，所以只在有网络时启动。
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 注意：`hbot serve` 会往 stdout 打一行 ready JSON（含实际监听地址与 pid），
# 那是启动成功的信号；Type=simple 不解析它，日志进 journald。
#
# 端口写死 127.0.0.1:8787 而不是默认的 :0：服务每次重启都换随机端口的话，
# 前面的探活/反向代理就没法配。要换端口改这一行，并同步改 README 的验证清单。
#
# 这里**故意**没有 --allow-remote：本服务不提供 TLS，绑非回环等于把 token 明文发出去。
# 真要对外，在前面放反向代理终结 TLS，再改成本机地址 + --allow-remote（见 README §5）。
ExecStart=/usr/local/bin/hbot serve --bind 127.0.0.1:8787 --data-dir /var/lib/hbot
# token 从 EnvironmentFile 读（内容就是 `HBOT_TOKEN=…` 一行，用 `hbot token --write` 生成）。
# 前缀 `-` 表示文件不存在也不报错 —— 但那种情况下 serve 会自己随机生成一个 token，
# 只有能从 journald 里读到它才连得上，所以正式部署请务必先生成这个文件。
EnvironmentFile=-/etc/hbot/hbot.env
# 让 Ctrl-C / systemctl stop 走 serve 已有的 SIGTERM 路径（停 bot → handle.shutdown()）。
KillSignal=SIGTERM
# 优雅退出最多等 30 秒（每个 bot 最多 5 秒停止宽限，见 hbot-rpc 的 STOP_GRACE）。
TimeoutStopSec=30

User=hbot
Group=hbot
StateDirectory=hbot
StateDirectoryMode=0750

# 崩溃/重启策略：正常退出（0）不重启，异常退出才重启，间隔 5 秒。
Restart=on-failure
RestartSec=5

# ---- 加固（hardening）----
# 这些选项都是"默认更严"，但**每一条都可能和"让 Agent 跑命令"冲突**，
# 所以下面每一条都写了取舍。改之前先读 packaging/README.md 的「加固与命令隔离」。
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictSUIDSGID=true
LockPersonality=true
# 只允许运行期需要的能力（不额外 AddCapability，serve 不需要 root）。
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
